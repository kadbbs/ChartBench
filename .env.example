# ===== 天勤历史数据配置 =====
# 主要给历史数据下载/归档脚本使用；Bitget 实盘链路不依赖它。
TQ_USER=你的天勤账号
TQ_PASSWORD=你的天勤密码

# ===== 默认运行参数 =====
# web_tq_chart.py 和 run_live_trading.py 会读取这些默认值。
# 命令行传入 --symbol / --duration 等参数时，会临时覆盖这里的值。
TQ_DEFAULT_PROVIDER=bitget
TQ_DEFAULT_SYMBOL=BTCUSDT

# 默认 K 线周期，单位秒。180=3m，300=5m，900=15m。
TQ_DEFAULT_DURATION_SECONDS=180

# 默认拉取 K 线数量。
TQ_DEFAULT_DATA_LENGTH=800

# 后端刷新/等待间隔，单位毫秒。
TQ_DEFAULT_REFRESH_MS=200

# 当前 Bitget 只支持 time。
TQ_DEFAULT_BAR_MODE=time

# Range/Renko 参数，当前 Bitget time 模式不会用到，保留默认即可。
TQ_DEFAULT_RANGE_TICKS=10
TQ_DEFAULT_BRICK_LENGTH=10000

# Web 服务默认监听地址和端口。
TQ_DEFAULT_HOST=0.0.0.0
TQ_DEFAULT_PORT=8050

# ===== Bitget API 配置 =====
# 行情公共接口不需要这些；账户摘要、设置杠杆、真实下单需要。
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# 当前项目默认跑 USDT 本位合约。
BITGET_DEFAULT_PRODUCT_TYPE=USDT-FUTURES
BITGET_PRODUCT_TYPES=USDT-FUTURES

# K 线口径：MARKET=成交价，MARK=标记价，INDEX=指数价。
BITGET_KLINE_TYPE=MARKET

# 如需指定 Bitget REST 或 WebSocket 节点，可取消注释。
# BITGET_API_BASE=https://api.bitget.com
# BITGET_WS_PUBLIC_URL=wss://ws.bitget.com/v2/ws/public

# ===== 邮件提醒配置 =====
# 邮件提醒依赖 Resend。
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ===== 实盘开关 =====
# 总开关。true 才允许进入真实交易路径。
LIVE_TRADING_ENABLED=false

# 干跑模式。true 会构造订单请求但不发送到 Bitget。
LIVE_TRADING_DRY_RUN=true

# 观察模式。true 时只写日志/发邮件，不构造真实下单请求。
# 要真实下单，必须改成 false。
LIVE_TRADING_LOG_ONLY=true

# 单笔下单数量。真实下单前必须填写，例如 0.001。
LIVE_TRADING_ORDER_SIZE=

# ===== 止盈止损 / R 倍数配置 =====
# true=真实开仓后自动挂止损和两档止盈；若无法计算 ATR 或标记价，会拒绝开仓。
LIVE_TRADING_TPSL_ENABLED=true

# 开仓保护单价格锚点。mark_price=标记价；bar_close=信号 K 线收盘价。
LIVE_TRADING_ENTRY_PRICE_SOURCE=mark_price

# 止盈止损触发价格类型。mark_price=标记价触发。
LIVE_TRADING_TPSL_TRIGGER_TYPE=mark_price

# ATR 周期。止损距离 R = ATR * LIVE_TRADING_STOP_ATR_MULTIPLIER。
LIVE_TRADING_ATR_PERIOD=14

# 2ATR 止损，即 1R。
LIVE_TRADING_STOP_ATR_MULTIPLIER=2

# 第一档止盈：1R，平 50% 仓位。
LIVE_TRADING_TP1_R_MULTIPLE=1
LIVE_TRADING_TP1_SIZE_RATIO=0.5

# 第二档止盈：1.5R，平剩余仓位。
LIVE_TRADING_TP2_R_MULTIPLE=1.5

# 价格和数量输出小数位；需要按 Bitget 合约规格调整。
LIVE_TRADING_PRICE_DECIMALS=2
LIVE_TRADING_SIZE_DECIMALS=6

# 保护单提交失败时自动重试次数和间隔。
LIVE_TRADING_TPSL_RETRY_ATTEMPTS=3
LIVE_TRADING_TPSL_RETRY_DELAY_SECONDS=1

# 保护单最终失败后是否自动市价平仓。
# false=只发紧急邮件；true=调用 Bitget close-positions 尝试平仓。
LIVE_TRADING_CLOSE_ON_TPSL_FAILURE=false

# 保护单状态监控。true=常驻进程会定期查询止损/止盈是否已触发，并发送邮件。
LIVE_TRADING_TPSL_MONITOR_ENABLED=true
LIVE_TRADING_TPSL_MONITOR_INTERVAL_SECONDS=30

# 保证金模式：crossed=全仓，isolated=逐仓。
LIVE_TRADING_MARGIN_MODE=crossed

# 保证金币种。
LIVE_TRADING_MARGIN_COIN=USDT

# 交易产品类型，应与 Bitget 合约类型一致。
LIVE_TRADING_PRODUCT_TYPE=USDT-FUTURES

# 持仓模式：one_way_mode=单向持仓，hedge_mode=双向持仓。
LIVE_TRADING_POSITION_MODE=one_way_mode

# 开仓订单类型：
# market=市价开仓；maker=post_only 限价挂单，成交后再挂止盈止损。
LIVE_TRADING_ENTRY_ORDER_TYPE=market

# maker 模式挂单距离：买单挂 best_bid 下方 N 个 tick；卖单挂 best_ask 上方 N 个 tick。
LIVE_TRADING_MAKER_PRICE_LEVELS=3

# maker post_only 开仓被拒/取消时，同一信号内重新取盘口并重试。
LIVE_TRADING_MAKER_RETRY_ATTEMPTS=3
LIVE_TRADING_MAKER_RETRY_DELAY_SECONDS=0.3

# maker 重试仍失败后是否降级为市价单开仓。
LIVE_TRADING_MAKER_FALLBACK_TO_MARKET=false

# 新开仓时间过滤。true=只允许在北京时间 START <= 当前时间 < END 内开仓。
# 这里只限制新开仓；已有仓位、保护单监控、止盈止损不受影响。
LIVE_TRADING_ENTRY_TIME_FILTER_ENABLED=false
LIVE_TRADING_ENTRY_TIME_START=20:00
LIVE_TRADING_ENTRY_TIME_END=24:00

# 高周期 Hull 趋势过滤。默认读取 1h 红/绿带：
# 1h 红色多趋势时禁止 5m 开空；1h 绿色空趋势时禁止 5m 开多。
LIVE_TRADING_HTF_HULL_FILTER_ENABLED=true
LIVE_TRADING_HTF_HULL_DURATION_SECONDS=3600

# 可选杠杆。为空则不主动设置杠杆。
LIVE_TRADING_LEVERAGE=

# 信号来源模式：
# any=Buy/买 或 Sell/卖 任一触发
# ut=只看 UT Bot 的 Buy/Sell
# dkx=只看 DKX 的 买/卖
# confirmed=UT 与 DKX 同向同时出现
# 当前默认策略 stc_extreme_contrarian 会优先使用自己的 STC 过滤逻辑。
LIVE_TRADING_SIGNAL_MODE=any

# 策略名。当前默认：
# 空单：Sell/卖 任一出现，且 STC > 75 并为红色
# 多单：Buy/买 任一出现，且 STC < 25 并为绿色
LIVE_TRADING_STRATEGY=stc_extreme_contrarian

# true=使用上一根已收完 K 线，适合实盘减少未收线重绘影响。
# false=使用当前正在形成的 K 线。
LIVE_TRADING_USE_CLOSED_BAR=true

# 邮件提醒开关。
LIVE_TRADING_EMAIL_ENABLED=true
LIVE_TRADING_EMAIL_TO=

# 可选：自定义日志路径。
# LIVE_TRADING_LOG_PATH=logs/live_trading.log
# LIVE_TRADING_ORDER_LOG_PATH=logs/live_trading_orders.jsonl
# LIVE_TRADING_STATE_PATH=logs/live_trading_state.json
