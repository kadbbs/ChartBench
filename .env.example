# =============================================================================
# 本机私密配置示例
# -----------------------------------------------------------------------------
# 复制本文件为 .env 后填写真实值：
#
# cp .env.example .env
#
# 运行参数已经迁移到：
# - config/defaults.yaml
# - config/profiles/email.yaml
# - config/profiles/dry_run_5u.yaml
# - config/profiles/live_5u.yaml
#
# 日常切换模式请使用：
# ./myvenv/bin/python run_live_trading.py --profile email --continuous
# ./myvenv/bin/python run_live_trading.py --profile dry_run_5u --continuous
# ./myvenv/bin/python run_live_trading.py --profile live_5u --preflight
# ./myvenv/bin/python run_live_trading.py --profile live_5u --continuous
# =============================================================================


# ===== Binance 私有接口凭据 =====
# 图表和回测的 Binance 公共行情不需要这些。
# 真实实盘需要 API Key / Secret。
# Futures Trade 权限用于下单/平仓；Transfer 权限用于合约账户不足时从现货自动划转。
# LIVE_TRADING_PROVIDER=binance
BINANCE_API_KEY=
BINANCE_API_SECRET=


# ===== 天勤量化账号 =====
# 只在图表 provider=tianqin 时需要；实盘和回测不会使用天勤。
TIANQIN_USERNAME=
TIANQIN_PASSWORD=


# ===== 邮件通知凭据 / 收件人 =====
# RESEND_API_KEY 为空时不会真正发出邮件。
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
LIVE_TRADING_EMAIL_TO=


# ===== 可选：自定义 Binance 接口节点 =====
# 通常不需要设置。
# BINANCE_FAPI_BASE=https://fapi.binance.com
# BINANCE_SPOT_BASE=https://api.binance.com
# BINANCE_WS_MARKET_BASE=wss://fstream.binance.com/market


# ===== Bitget 私有接口凭据 =====
# 图表和回测的 Bitget 公共行情不需要这些。
# 真实实盘选择 provider=bitget 时需要 API Key / Secret / Passphrase。
# LIVE_TRADING_PROVIDER=bitget
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=


# ===== 可选：自定义 Bitget 接口节点 =====
# 通常不需要设置；只有在你明确要切换 Bitget 节点时再打开。
# BITGET_API_BASE=https://api.bitget.com
# BITGET_WS_PUBLIC_URL=wss://ws.bitget.com/v2/ws/public


# ===== 可选：自定义日志路径 =====
# 通常不需要设置；默认写到 logs/。
# LIVE_TRADING_LOG_PATH=logs/live_trading.log
# LIVE_TRADING_ORDER_LOG_PATH=logs/live_trading_orders.jsonl
# LIVE_TRADING_STATE_PATH=logs/live_trading_state.json
