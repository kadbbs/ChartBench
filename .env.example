# =============================================================================
# 本机私密配置示例
# -----------------------------------------------------------------------------
# 复制本文件为 .env 后填写真实值：
#
# cp .env.example .env
#
# 运行参数已经迁移到：
# - config/defaults.yaml
# - config/profiles/email.yaml
# - config/profiles/dry_run_5u.yaml
# - config/profiles/live_5u.yaml
#
# 日常切换模式请使用：
# ./myvenv/bin/python run_live_trading.py --profile email --continuous
# ./myvenv/bin/python run_live_trading.py --profile dry_run_5u --continuous
# ./myvenv/bin/python run_live_trading.py --profile live_5u --preflight
# ./myvenv/bin/python run_live_trading.py --profile live_5u --continuous
# =============================================================================


# ===== Bitget 私有接口凭据 =====
# 行情公共接口不需要这些。
# 真实实盘需要 API Key / Secret / Passphrase。
# Trade 权限用于下单；Transfer 权限用于合约账户不足 5U 时从现货自动划转。
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=


# ===== 邮件通知凭据 / 收件人 =====
# RESEND_API_KEY 为空时不会真正发出邮件。
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
LIVE_TRADING_EMAIL_TO=


# ===== 可选：自定义接口节点 =====
# 通常不需要设置；只有在你明确要切换 Bitget 节点时再打开。
# BITGET_API_BASE=https://api.bitget.com
# BITGET_WS_PUBLIC_URL=wss://ws.bitget.com/v2/ws/public


# ===== 可选：自定义日志路径 =====
# 通常不需要设置；默认写到 logs/。
# LIVE_TRADING_LOG_PATH=logs/live_trading.log
# LIVE_TRADING_ORDER_LOG_PATH=logs/live_trading_orders.jsonl
# LIVE_TRADING_STATE_PATH=logs/live_trading_state.json
